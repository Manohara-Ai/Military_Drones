<?xml version="1.0"?>
<robot name="quadrotor">

    <material name="black"><color rgba="0 0 0 1"/></material>
    <material name="red"><color rgba="0.8 0 0 1"/></material>

    <link name="base_footprint" />

    <link name="base_link">
        <inertial>
            <mass value="1.5"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0347563" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.0977"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://military_drones_description/models/quadrotor/meshes/drone_base.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <geometry><box size="0.47 0.47 0.28"/></geometry>
        </collision>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </joint>

    <link name="rotor_front_left">
        <visual>
            <geometry><cylinder radius="0.015" length="0.03"/></geometry>
            <material name="black"/>
        </visual>
        <collision><geometry><cylinder radius="0.015" length="0.03"/></geometry></collision>
        <inertial><mass value="0.02"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    </link>
    <joint name="rotor_front_left_joint" type="fixed">
        <parent link="base_link"/><child link="rotor_front_left"/>
        <origin xyz="0.145 0.145 0.01" rpy="0 0 0"/>
    </joint>

    <link name="rotor_front_right">
        <visual>
            <geometry><cylinder radius="0.015" length="0.03"/></geometry>
            <material name="black"/>
        </visual>
        <collision><geometry><cylinder radius="0.015" length="0.03"/></geometry></collision>
        <inertial><mass value="0.02"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    </link>
    <joint name="rotor_front_right_joint" type="fixed">
        <parent link="base_link"/><child link="rotor_front_right"/>
        <origin xyz="0.145 -0.145 0.01" rpy="0 0 0"/>
    </joint>

    <link name="rotor_rear_left">
        <visual>
            <geometry><cylinder radius="0.015" length="0.03"/></geometry>
            <material name="black"/>
        </visual>
        <collision><geometry><cylinder radius="0.015" length="0.03"/></geometry></collision>
        <inertial><mass value="0.02"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    </link>
    <joint name="rotor_rear_left_joint" type="fixed">
        <parent link="base_link"/><child link="rotor_rear_left"/>
        <origin xyz="-0.145 0.145 0.01" rpy="0 0 0"/>
    </joint>

    <link name="rotor_rear_right">
        <visual>
            <geometry><cylinder radius="0.015" length="0.03"/></geometry>
            <material name="black"/>
        </visual>
        <collision><geometry><cylinder radius="0.015" length="0.03"/></geometry></collision>
        <inertial><mass value="0.02"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    </link>
    <joint name="rotor_rear_right_joint" type="fixed">
        <parent link="base_link"/><child link="rotor_rear_right"/>
        <origin xyz="-0.145 -0.145 0.01" rpy="0 0 0"/>
    </joint>

    <link name="prop_front_left">
        <inertial>
            <mass value="0.005"/>
            <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="4.17041e-05" iyz="0" izz="4.26041e-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://military_drones_description/models/quadrotor/meshes/propeller_red.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><cylinder radius="0.14" length="0.008"/></geometry>
        </collision>
    </link>

    <link name="prop_front_right">
        <inertial>
            <mass value="0.005"/>
            <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="4.17041e-05" iyz="0" izz="4.26041e-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://military_drones_description/models/quadrotor/meshes/propeller_black.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><cylinder radius="0.14" length="0.008"/></geometry>
        </collision>
    </link>

    <link name="prop_rear_left">
        <inertial>
            <mass value="0.005"/>
            <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="4.17041e-05" iyz="0" izz="4.26041e-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://military_drones_description/models/quadrotor/meshes/propeller_red.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><cylinder radius="0.14" length="0.008"/></geometry>
        </collision>
    </link>

    <link name="prop_rear_right">
        <inertial>
            <mass value="0.005"/>
            <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="4.17041e-05" iyz="0" izz="4.26041e-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://military_drones_description/models/quadrotor/meshes/propeller_black.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><cylinder radius="0.14" length="0.008"/></geometry>
        </collision>
    </link>

    <joint name="front_left_prop_joint" type="continuous">
        <parent link="base_link"/><child link="prop_front_left"/>
        <origin xyz="0.145 0.145 0.02" rpy="0 0 0"/><axis xyz="0 0 1"/>
    </joint>

    <joint name="front_right_prop_joint" type="continuous">
        <parent link="base_link"/><child link="prop_front_right"/>
        <origin xyz="0.145 -0.145 0.02" rpy="0 0 0"/><axis xyz="0 0 1"/>
    </joint>

    <joint name="rear_left_prop_joint" type="continuous">
        <parent link="base_link"/><child link="prop_rear_left"/>
        <origin xyz="-0.145 0.145 0.02" rpy="0 0 0"/><axis xyz="0 0 1"/>
    </joint>

    <joint name="rear_right_prop_joint" type="continuous">
        <parent link="base_link"/><child link="prop_rear_right"/>
        <origin xyz="-0.145 -0.145 0.02" rpy="0 0 0"/><axis xyz="0 0 1"/>
    </joint>

    <gazebo>
        <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>quadrotor</robotNamespace>
            <jointName>front_left_prop_joint</jointName>
            <linkName>prop_front_left</linkName>
            <turningDirection>ccw</turningDirection>
            <timeConstantUp>0.0125</timeConstantUp>
            <timeConstantDown>0.025</timeConstantDown>
            <maxRotVelocity>800.0</maxRotVelocity>
            <motorConstant>8.54858e-06</motorConstant>
            <momentConstant>0.016</momentConstant>
            <commandSubTopic>motor_speed</commandSubTopic>
            <motorNumber>0</motorNumber>
            <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
            <motorType>velocity</motorType>
        </plugin>

        <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>quadrotor</robotNamespace>
            <jointName>front_right_prop_joint</jointName>
            <linkName>prop_front_right</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.0125</timeConstantUp>
            <timeConstantDown>0.025</timeConstantDown>
            <maxRotVelocity>800.0</maxRotVelocity>
            <motorConstant>8.54858e-06</motorConstant>
            <momentConstant>0.016</momentConstant>
            <commandSubTopic>motor_speed</commandSubTopic>
            <motorNumber>1</motorNumber>
            <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
            <motorType>velocity</motorType>
        </plugin>

        <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>quadrotor</robotNamespace>
            <jointName>rear_left_prop_joint</jointName>
            <linkName>prop_rear_left</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.0125</timeConstantUp>
            <timeConstantDown>0.025</timeConstantDown>
            <maxRotVelocity>800.0</maxRotVelocity>
            <motorConstant>8.54858e-06</motorConstant>
            <momentConstant>0.016</momentConstant>
            <commandSubTopic>motor_speed</commandSubTopic>
            <motorNumber>2</motorNumber>
            <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
            <motorType>velocity</motorType>
        </plugin>

        <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>quadrotor</robotNamespace>
            <jointName>rear_right_prop_joint</jointName>
            <linkName>prop_rear_right</linkName>
            <turningDirection>ccw</turningDirection>
            <timeConstantUp>0.0125</timeConstantUp>
            <timeConstantDown>0.025</timeConstantDown>
            <maxRotVelocity>800.0</maxRotVelocity>
            <motorConstant>8.54858e-06</motorConstant>
            <momentConstant>0.016</momentConstant>
            <commandSubTopic>motor_speed</commandSubTopic>
            <motorNumber>3</motorNumber>
            <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
            <motorType>velocity</motorType>
        </plugin>

        <plugin filename="gz-sim-multicopter-control-system" name="gz::sim::systems::MulticopterVelocityControl">
            <robotNamespace>quadrotor</robotNamespace>
            <commandSubTopic>cmd_vel</commandSubTopic>
            <enableSubTopic>enable</enableSubTopic>
            <comLinkName>base_footprint</comLinkName>
            <velocityGain>2.7 2.7 2.7</velocityGain>
            <attitudeGain>2 3 0.15</attitudeGain>
            <angularRateGain>0.4 0.52 0.18</angularRateGain>
            <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>
            <rotorConfiguration>
                <rotor>
                    <jointName>front_left_prop_joint</jointName>
                    <forceConstant>8.54858e-06</forceConstant>
                    <momentConstant>0.016</momentConstant>
                    <direction>1</direction>
                </rotor>
                <rotor>
                    <jointName>front_right_prop_joint</jointName>
                    <forceConstant>8.54858e-06</forceConstant>
                    <momentConstant>0.016</momentConstant>
                    <direction>-1</direction>
                </rotor>
                <rotor>
                    <jointName>rear_left_prop_joint</jointName>
                    <forceConstant>8.54858e-06</forceConstant>
                    <momentConstant>0.016</momentConstant>
                    <direction>-1</direction>
                </rotor>
                <rotor>
                    <jointName>rear_right_prop_joint</jointName>
                    <forceConstant>8.54858e-06</forceConstant>
                    <momentConstant>0.016</momentConstant>
                    <direction>1</direction>
                </rotor>
            </rotorConfiguration>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <joint_name>front_left_prop_joint</joint_name>
            <joint_name>front_right_prop_joint</joint_name>
            <joint_name>rear_left_prop_joint</joint_name>
            <joint_name>rear_right_prop_joint</joint_name>
        </plugin>
    </gazebo>

</robot>